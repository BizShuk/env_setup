{
  "name": "env-setup",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "description": "機器初始化與開發者工具箱 (developer toolbox)：安裝 macOS / Ubuntu toolchain、軟連結 dotfiles，並提供 install / uninstall / dump / system / cleanup / backup / network commands。",
  "scripts": {
    "lint": "find scripts bin -type f -name \"*.sh\" -exec bash -n {} +",
    "test": "bash scripts/test_bash_plugin.sh",
    "test:docker": "DOCKER_TEST_IMAGE=\"${DOCKER_TEST_IMAGE:-ubuntu:26.04}\" bash scripts/test_docker_install.sh",
    "clean": "rm -f *.log **/*.log .*.tmp.* .*.err.*",
    "ci": "pnpm run lint && pnpm run test",

    "run:setup": "./run.sh",
    "run:bootstrap": "./setup.sh",
    "run:prereq": "./scripts/check_prereq.sh",
    "run:bash-env": "./scripts/bash_env_setup.sh",
    "run:settings": "./scripts/settings.sh",

    "run:mac": "./scripts/mac.sh",
    "run:mac:prereq": "./scripts/check_prereq.sh",
    "run:mac:env": "./scripts/bash_env_setup.sh",
    "run:mac:brew": "./scripts/brew.sh",
    "run:mac:basic": "./scripts/mac_basic.sh",
    "run:mac:bash": "bash scripts/bash.sh",
    "run:mac:go": "./scripts/go.sh",
    "run:mac:nodejs": "./scripts/nodejs.sh",
    "run:mac:pnpm": "./scripts/pnpm.sh",
    "run:mac:uv": "./scripts/uv.sh",
    "run:mac:openssl": "./scripts/openssl_mac_setup.sh",
    "run:mac:ctags": "./scripts/ctags_setup.sh",
    "run:mac:vim": "./scripts/vim.sh",

    "run:ubuntu": "./scripts/ubuntu.sh",
    "run:ubuntu:prereq": "./scripts/check_prereq.sh",
    "run:ubuntu:env": "./scripts/bash_env_setup.sh",
    "run:ubuntu:apt": "bash scripts/ubuntu_apt.sh",
    "run:ubuntu:locale": "bash scripts/ubuntu_locale.sh",
    "run:ubuntu:timezone": "bash scripts/ubuntu_timezone.sh",
    "run:ubuntu:user": "bash scripts/ubuntu_user.sh",
    "run:ubuntu:git": "./scripts/git.sh",
    "run:ubuntu:go": "./scripts/go.sh",
    "run:ubuntu:nodejs": "./scripts/nodejs.sh",
    "run:ubuntu:pnpm": "./scripts/pnpm.sh",
    "run:ubuntu:vim": "./scripts/vim.sh",
    "run:ubuntu:openssl": "bash scripts/openssl_setup.sh",
    "run:ubuntu:webmin": "./scripts/webmin.sh",

    "run:brew": "./scripts/brew.sh",
    "run:go": "./scripts/go.sh",
    "run:nodejs": "./scripts/nodejs.sh",
    "run:nodejs:nvm": "./scripts/nodejs_nvm.sh",
    "run:pnpm": "./scripts/pnpm.sh",
    "run:vim": "./scripts/vim.sh",
    "run:git": "./scripts/git.sh",
    "run:git-secret": "./scripts/git-secret.sh",
    "run:ctags": "./scripts/ctags_setup.sh",
    "run:openssl": "bash scripts/openssl_setup.sh",
    "run:openssl-mac": "./scripts/openssl_mac_setup.sh",
    "run:webmin": "./scripts/webmin.sh",
    "run:mount-disk": "bash scripts/disk/mount_disk.sh",
    "run:mount-disk-fstab": "bash scripts/disk/mount_disk_by_fstab.sh",
    "run:pm2-apply": "pm2 apply",

    "run:dump:mac": "bash scripts/dump/mac.sh",
    "run:dump:vscode": "bash scripts/dump/vscode.sh",
    "run:dump:antigravity": "bash scripts/dump/antigravity.sh",

    "run:install:vscode": "bash scripts/install/vscode.sh",
    "run:install:antigravity": "bash scripts/install/antigravity.sh",

    "run:backup": "bash scripts/backup/backup.sh",
    "run:backup:list": "bash scripts/backup/list.sh",
    "run:backup:import": "bash scripts/backup/import.sh",
    "run:backup:init": "bash scripts/backup/init.sh",

    "run:cleanup": "bash scripts/cleanup/all.sh",
    "run:cleanup:system-log": "bash scripts/cleanup/system_log.sh",
    "run:cleanup:system-tmp": "bash scripts/cleanup/system_tmp.sh",
    "run:cleanup:cache-user": "bash scripts/cleanup/cache_user.sh",
    "run:cleanup:docker": "bash scripts/cleanup/docker.sh",
    "run:cleanup:brew": "bash scripts/cleanup/brew.sh",
    "run:cleanup:node": "bash scripts/cleanup/node.sh",
    "run:cleanup:python": "bash scripts/cleanup/python.sh",
    "run:cleanup:go": "bash scripts/cleanup/go.sh",
    "run:cleanup:ai": "bash scripts/cleanup/ai.sh",
    "run:cleanup:browser": "bash scripts/cleanup/browser.sh",
    "run:cleanup:app": "bash scripts/cleanup/app.sh",

    "run:system:show": "bash scripts/system/show.sh",
    "run:system:cpu": "bash scripts/system/cpu.sh",
    "run:system:memory": "bash scripts/system/memory.sh",
    "run:system:disk": "bash scripts/system/disk.sh",
    "run:system:network": "bash scripts/system/network.sh",
    "run:system:os": "bash scripts/system/os.sh",
    "run:system:gpu": "bash scripts/system/gpu.sh",
    "run:system:display": "bash scripts/system/display.sh",
    "run:system:usb": "bash scripts/system/usb.sh",
    "run:system:input": "bash scripts/system/input.sh",
    "run:system:audio": "bash scripts/system/audio.sh",
    "run:system:energy": "bash scripts/system/energy.sh",
    "run:system:disk-verify": "bash scripts/system/disk_verify.sh",

    "run:network:private": "bash scripts/network/private.sh",
    "run:network:target": "bash scripts/network/target.sh",

    "run:uninstall:codex": "bash scripts/uninstall/codex.sh",

    "run:io:probe": "bash scripts/io/probe.sh",
    "run:io:bench": "bash scripts/io/bench.sh"
  }
}
